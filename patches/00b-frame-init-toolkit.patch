--- a/content/browser/renderer_host/render_frame_host_impl.cc
+++ b/content/browser/renderer_host/render_frame_host_impl.cc
@@ -1,3 +1,4 @@
+#include "third_party/blink/renderer/core/privacy/fingerprint_toolkit.h"
+#include "base/command_line.h"

 // In RenderFrameHostImpl::CommitNavigation() or frame init,
 // after LocalFrame is created, inject FingerprintToolkit:
+
+  auto* cmd = base::CommandLine::ForCurrentProcess();
+  FingerprintConfig cfg;
+  cfg.timezone = String(cmd->GetSwitchValueASCII("fingerprint-timezone").c_str());
+  cfg.language = String(cmd->GetSwitchValueASCII("fingerprint-language").c_str());
+  cfg.platform = String(cmd->GetSwitchValueASCII("fingerprint-platform").c_str());
+
+  // Generate random seed per renderer process (or use fixed seed if provided)
+  uint64_t seed = base::RandUint64();
+  const std::string seed_str = cmd->GetSwitchValueASCII("fingerprint-seed");
+  if (!seed_str.empty()) seed = std::stoull(seed_str);
+
+  frame->SetFingerprintToolkit(
+      std::make_unique<FingerprintToolkit>(seed, cfg));

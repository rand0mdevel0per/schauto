--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -1,3 +1,4 @@
+#include "third_party/blink/renderer/core/privacy/fingerprint_toolkit.h"

 // In WebGLRenderingContextBase::getParameter(GLenum pname):
 // Add before the switch/case for GL_VENDOR, GL_RENDERER:
@@ -10,6 +11,14 @@
+  auto* toolkit = GetDocument().GetFrame()->GetFingerprintToolkit();
+  if (toolkit) {
+    switch (pname) {
+      case GL_VENDOR:
+      case 0x9245:  // UNMASKED_VENDOR_WEBGL
+        return WebGLAny(script_state, toolkit->SpoofWebGLVendor());
+      case GL_RENDERER:
+      case 0x9246:  // UNMASKED_RENDERER_WEBGL
+        return WebGLAny(script_state, toolkit->SpoofWebGLRenderer());
+    }
+  }

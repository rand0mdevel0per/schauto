{
  "manifest_version": 3,
  "name": "Adblock Plus",
  "version": "3.21",
  "description": "Built-in ad blocker",
  "permissions": ["webRequest", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
